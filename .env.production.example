APP_NAME=FinBank
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_SUBDOMAIN.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=YOUR_INFINITYFREE_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=YOUR_INFINITYFREE_DATABASE_NAME
DB_USERNAME=YOUR_INFINITYFREE_DATABASE_USER
DB_PASSWORD=YOUR_INFINITYFREE_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
